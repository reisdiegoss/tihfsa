# ============================================================
#  TIHFSA — Arquivo de Exemplo de Configuração de Ambiente (.env)
#  Hotel Fasano Salvador — Sistema Integrado de Gestão de TI
# ============================================================
#  Instruções:
#  Copie este arquivo para .env na raiz do projeto e ajuste
#  as variáveis de acordo com o ambiente do servidor.
#  Exemplo: cp .env.example .env
# ============================================================

# ── Banco de Dados (PostgreSQL) ──────────────────────────────
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
# O script start.sh criará o banco e as tabelas automaticamente se não existirem.
DATABASE_URL=postgresql://postgres:Netfasano@sa1@localhost:5432/tihfsa

# ── Autenticação LDAP / Active Directory ─────────────────────
# Servidor de domínio para autenticação de colaboradores e gestores
LDAP_HOST=192.168.10.10
LDAP_PORT=389
LDAP_BASE_DN=OU=Usuarios,DC=fasano,DC=local
LDAP_BIND_USER=fasano\consulta_ti
LDAP_BIND_PASSWORD=SuaSenhaAdAqui

# ── Segurança & Sessão (JWT) ─────────────────────────────────
# Gere uma chave forte (ex: openssl rand -hex 32)
JWT_SECRET_KEY=tihfsa-super-secret-security-token-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# ── Servidor de E-mail (SMTP / Alertas e Notificações) ───────
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=suporte.ti@fasanosalvador.com.br
SMTP_PASSWORD=SuaSenhaDeEmail
SMTP_FROM_NAME=TIHFSA - Hotel Fasano Salvador

# ── Monitoramento NOC (Zabbix API) ───────────────────────────
ZABBIX_API_URL=http://192.168.10.15/zabbix/api_jsonrpc.php
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix

# ── Administrador Raiz (Fallback Local sem LDAP) ─────────────
# Usuário de emergência para acesso irrestrito ao painel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Netfasano@sa1
ADMIN_EMAIL=ti-hfs@fasano.com.br

# ── Configurações Gerais da Aplicação ────────────────────────
APP_NAME=TIHFSA
# URL base para links enviados por e-mail e redirects
APP_BASE_URL=https://localhost
